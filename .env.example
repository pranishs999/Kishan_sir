# Google Cloud Translation API Configuration
# Copy this file to .env and fill in your values
# NEVER commit actual credentials to version control

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Path to Google Cloud Service Account Key JSON file
# Create a service account with Cloud Translation API access
# Download the JSON key and place it in a secure location (outside repo)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Optional: Specify region (default: global)
# GOOGLE_CLOUD_LOCATION=global

# Optional: Translation API settings
# TRANSLATION_SOURCE_LANGUAGE=en
# TRANSLATION_TARGET_LANGUAGE=ne